{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canvas-daily-assignment-reminder",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  }
}
