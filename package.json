{
  "name": "canvas-daily-assignment-reminder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@cloudflare/puppeteer": "^1.3.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node --experimental-strip-types --test tests/*.test.ts",
    "types": "wrangler types --config wrangler.jsonc",
    "types:check": "wrangler types --check --config wrangler.jsonc",
    "dev": "wrangler dev --test-scheduled --config wrangler.jsonc",
    "deploy:preview": "wrangler deploy --config wrangler.jsonc",
    "deploy:scheduled": "wrangler deploy --config wrangler.cron.jsonc"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "wrangler": "4.120.0"
  }
}
